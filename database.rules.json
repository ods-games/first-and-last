{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (!data.child('guest').exists() && newData.child('guest').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)",
        "used": {
          "$word": {
            ".validate": "!data.exists() && ($word.matches(/^[a-z]{3,16}$/) || ($word.length >= 2 && $word.length <= 7 && !$word.matches(/[a-zA-Z0-9 ]/)))"
          }
        }
      }
    },
    "nicks": {
      "$nick": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
        ".validate": "$nick.length >= 2 && $nick.length <= 10"
      }
    },
    "match": {
      "waiting": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('code').isString()"
      },
      "waiting_ko": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('code').isString()"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "stats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "active": {
        "$day": {
          ".validate": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        }
      },
      "days": {
        "$day": {
          ".validate": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
          "$k": {
            ".write": "auth != null",
            ".validate": "$k.matches(/^(ai|duo|online|words)$/) && newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 20"
          }
        }
      }
    },
    "bugs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().child('bugLast').child(auth.uid).val() === now && (!root.child('bugLast').child(auth.uid).exists() || root.child('bugLast').child(auth.uid).val() < now - 55000)",
        ".validate": "newData.hasChildren(['uid','t','kind','text','status'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "kind": {
          ".validate": "newData.isString() && newData.val().matches(/^(word|bug|screen|sound|etc)$/)"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(new|seen|done)$/)"
        },
        "word": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "wordIs": {
          ".validate": "newData.isString() && newData.val().matches(/^(missing|wrong)$/)"
        },
        "wl": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "contact": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "nick": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "shot": {
          ".validate": "newData.isBoolean()"
        },
        "info": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bugShots": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.parent().parent().child('bugs').child($id).child('uid').val() === auth.uid && !root.child('bugs').child($id).exists()",
        ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/jpeg;base64,')"
      }
    },
    "bugLast": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now"
      }
    }
  }
}